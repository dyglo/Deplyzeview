{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeplyzeView",
  "version": "0.1.9",
  "identifier": "com.deplyzeview.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DeplyzeView",
        "width": 1280,
        "height": 760,
        "minWidth": 760,
        "minHeight": 480,
        "decorations": false,
        "backgroundColor": "#101114",
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src ipc: http://ipc.localhost; img-src 'self' asset: data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
