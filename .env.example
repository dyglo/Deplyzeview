# LOCAL DEVELOPMENT ONLY. Never add VITE_ or TAURI_ prefixes to secrets.
# Gateway server (production: configure these in your backend's secret environment).
MARKET_DATA_HOST=127.0.0.1
MARKET_DATA_PORT=8787
MARKET_DATA_PROVIDERS=oanda,narwhal
# Add ,finzdata to enable optional individual-contract daily history.
# Comma-separated independent random app access tokens, >=32 characters each.
# These authenticate DeplyzeView clients, NOT provider API requests. Rotate/revoke per device.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MARKET_DATA_APP_TOKENS=
# OANDA v20 personal access token: Authorization: Bearer <token>
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice
# Narwhal: Authorization: Bearer <key>; free/basic/pro describes entitlement, not an upgrade.
NARWHAL_API_KEY=
NARWHAL_PLAN=free
# FinzData uses X-API-Key. Optional daily contract-history supplement.
FINZDATA_API_KEY=

# Desktop Rust process: only public URL may be embedded at compile time.
# Local .env loaded by `npm run desktop:dev`; production URL: https://your-backend.example
DEPLYZEVIEW_GATEWAY_URL=http://127.0.0.1:8787
# A per-device APPLICATION token from MARKET_DATA_APP_TOKENS, never a provider key.
# Runtime only; production provision via OS environment or per-user gateway.json (see docs).
DEPLYZEVIEW_APP_TOKEN=
